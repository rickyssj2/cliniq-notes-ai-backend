{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Meeting Webhook Service",
  "uid": "meeting-webhook",
  "schemaVersion": 39,
  "tags": ["meeting-webhook"],
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Webhook events received (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (event) (rate(webhook_events_received_total[1m]))",
          "legendFormat": "{{event}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Consumer processing outcome (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (event, outcome) (rate(consumer_events_processed_total[1m]))",
          "legendFormat": "{{event}} · {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Event processing time (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, event) (rate(consumer_event_processing_time_seconds_bucket[5m])))",
          "legendFormat": "p95 {{event}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Transcript reconstructions (total)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(transcript_reconstruction_count_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Dead-lettered records (rate)",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (topic, cause) (rate(kafka_consumer_dlq_count_total[5m]))",
          "legendFormat": "{{topic}} · {{cause}}",
          "refId": "A"
        }
      ]
    }
  ]
}
